# ── AiAS v1.2 (DevNetwork) runtime configuration ────────────────────────────
# Copy to .env (or export in your shell / service unit) and adjust.
# Every variable is optional — defaults shown are what the code assumes.

# ── Storage engine ───────────────────────────────────────────────────────────
# nedb (default): all state lives in NEDB via a nedbd daemon — AiAS v1.2 mode.
# redis: the original DevNetwork deployment mode (devnet.Interchained.org).
DEVNET_STORAGE=nedb

# NEDB mode (DEVNET_STORAGE=nedb)
NEDBD_URL=http://localhost:7070
NEDB_DB=devnet
# Shared secret between this app and the daemon. When set on nedbd, every
# /v1 route requires it (401 otherwise) — set the SAME value both sides.
NEDBD_TOKEN=change_me_shared_secret
# DEVNET_REDIS_NAMESPACE=            # key namespace; devnet keys are raw — leave empty

# Redis mode (DEVNET_STORAGE=redis) — legacy parity only
DEVNET_REDIS_HOST=localhost
DEVNET_REDIS_PORT=6379
DEVNET_REDIS_DB=11

# ── Identity ─────────────────────────────────────────────────────────────────
# aias (default): ONE identity — the landing signs you into AiAS production
#   (login + register proxy to AIAS_API_BASE; your v1 session token is THE
#   credential everywhere: social features + inline weave views).
# local: self-contained accounts (offline dev / air-gapped boots).
DEVNET_AUTH=aias
# AIAS_TOKEN_CACHE_S=300             # how long a verified token is trusted

# ── Auth & sessions ──────────────────────────────────────────────────────────
# AUTH_SALT=change_me_in_production  # fingerprint-hash salt (legacy auth path)
DEVNET_SESSION_TTL_S=2592000         # v1-style session lifetime (30 days)

# ── The AiAS weave ───────────────────────────────────────────────────────────
# Where the AiAS v1 brain lives. Inline views (Playground, KeyStone, …) call
# it cross-origin with a bridged X-Session-Token.
AIAS_API_BASE=https://api.aiassist.net

# ── System bots ──────────────────────────────────────────────────────────────
# Demo/simulation bots from original DevNetwork. OFF by default in v1.2 —
# real agents arrive through the bot-platform APIs (Phase 2).
DEVNET_SYSTEM_BOTS=off
# BOT_MIN_INTERVAL=30
# BOT_MAX_INTERVAL=120
# BOT_MAX_REPLIES=3
# BOT_LLM_MODEL=moonshotai/kimi-k2-instruct
# AIASSIST_API_KEY=                  # bot LLM replies via AiAS v1 (Phase 2)

# ── Server ───────────────────────────────────────────────────────────────────
# HOST=0.0.0.0
# WORKERS=1                          # NEDB mode enforces 1 (in-process pub/sub)
