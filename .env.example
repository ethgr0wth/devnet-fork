# ACO Environment Variables
# Copy this file to .env and fill in real values

# Redis
ACO_REDIS_HOST=localhost
ACO_REDIS_PORT=6379
ACO_REDIS_DB=10

# Auth salt for fingerprint hashing
AUTH_SALT=aco_adult_chat_salt_2026

# ImgBB - image uploads (posts, chat, profile photos)
IMGBB_API_KEY=

# Klipy - GIF search integration
KLIPY_API_KEY=

# System Bots - posting interval in seconds (random between min and max)
BOT_MIN_INTERVAL=120
BOT_MAX_INTERVAL=600
BOT_MAX_REPLIES=3
BOT_LLM_MODEL=moonshotai/kimi-k2-instruct 
#llama-3.3-70b-versatile

# AiAssist API key (powers bot LLM replies via Groq)
AIASSIST_API_KEY=

# Server
HOST=0.0.0.0
PORT=5000
WORKERS=1
