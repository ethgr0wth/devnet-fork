{
  "name": "devnetwork",
  "version": "2.2.2",
  "main": "index.js",
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/frontend/input.css -o ./src/static/styles.css --minify --config ./tailwind.config.js",
    "build:js": "npx esbuild src/frontend/app.ts --bundle --outfile=src/static/app.js --format=iife --target=es2020 --jsx=automatic --alias:@=./src/frontend/v1 --alias:wouter=./src/frontend/v1/lib/wouter-shim.tsx --loader:.png=dataurl",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "npx tailwindcss -i ./src/frontend/input.css -o ./src/static/styles.css --watch --config ./tailwind.config.js",
    "watch:js": "npx esbuild src/frontend/app.ts --bundle --outfile=src/static/app.js --format=iife --target=es2020 --jsx=automatic --alias:@=./src/frontend/v1 --alias:wouter=./src/frontend/v1/lib/wouter-shim.tsx --loader:.png=dataurl --watch"
  },
  "keywords": [],
  "author": "Interchained LLC",
  "license": "SEE LICENSE IN LICENSE",
  "description": "DevNetwork \u2014 Professional networking for builders, creators, and developers.",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@types/dompurify": "^3.0.5",
    "class-variance-authority": "^0.7.1",
    "dompurify": "^3.3.1",
    "esbuild": "^0.27.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "marked": "^17.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "tailwindcss": "^3.4.19"
  }
}