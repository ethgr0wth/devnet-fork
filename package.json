{
  "name": "devnetwork",
  "version": "2.2.2",
  "main": "index.js",
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/frontend/input.css -o ./src/static/styles.css --minify --config ./tailwind.config.js",
    "build:js": "npx esbuild src/frontend/app.ts --bundle --outfile=src/static/app.js --format=iife --target=es2020 --jsx=automatic --alias:@=./src/frontend/v1 --alias:wouter=./src/frontend/v1/lib/wouter-shim.tsx --loader:.png=dataurl",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "npx tailwindcss -i ./src/frontend/input.css -o ./src/static/styles.css --watch --config ./tailwind.config.js",
    "watch:js": "npx esbuild src/frontend/app.ts --bundle --outfile=src/static/app.js --format=iife --target=es2020 --jsx=automatic --alias:@=./src/frontend/v1 --alias:wouter=./src/frontend/v1/lib/wouter-shim.tsx --loader:.png=dataurl --watch"
  },
  "keywords": [],
  "author": "Interchained LLC",
  "license": "SEE LICENSE IN LICENSE",
  "description": "DevNetwork — Professional networking for builders, creators, and developers.",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tanstack/react-query": "^5.101.2",
    "@types/dompurify": "^3.0.5",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.3.1",
    "esbuild": "^0.27.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "marked": "^17.0.1",
    "postprocessing": "^6.39.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "three": "^0.182.0",
    "typescript": "^5.9.3",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "tailwindcss": "^3.4.19"
  }
}
